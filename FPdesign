# outfit creater that takes input of list of possible items of clothes and considers constraits
    #then returns outfit ideas
import json
import os
import random


print("welcome to your personal stylist!")


def load_data():
    if os.path.exists("wardrobes.json"):
        with open("wardrobes.json", "r") as file:
            return json.load(file)
    return {}

def save_data(data):
    with open("wardrobes.json", "w") as file:
        json.dump(data, file, indent=4)

def empty_wardrobe():
    return {
        "tops": [],
        "bottoms": [],
        "outerwear": [],
        "shoes": [],
        "accessories": [],
        "dresses": []
    }

def show_wardrobe(wardrobe):
    print("\nYour wardrobe:")
    for category, items in wardrobe.items():
        if items:
            print(f"{category.title()}: {', '.join(items)}")
        else:
            print(f"{category.title()}: None")

def generate_outfit(wardrobe, occasion, weather):
    outfit = {}

    if wardrobe["dresses"] and occasion in ["formal / event", "date"]:
        outfit["dress"] = random.choice(wardrobe["dresses"])
    else:
        if wardrobe["tops"]:
            outfit["top"] = random.choice(wardrobe["tops"])
        if wardrobe["bottoms"]:
            outfit["bottom"] = random.choice(wardrobe["bottoms"])

    if wardrobe["shoes"]:
        outfit["shoes"] = random.choice(wardrobe["shoes"])

    if weather in ["cold", "rainy"] and wardrobe["outerwear"]:
        outfit["outerwear"] = random.choice(wardrobe["outerwear"])

    if wardrobe["accessories"]:
        outfit["accessory"] = random.choice(wardrobe["accessories"])

    return outfit

data = load_data()

username = input("Enter your username: ").strip().lower()

if username in data:
    print(f"Welcome back, {username}!")
    wardrobe = data[username]
else:
    print(f"Creating new profile for {username}.")
    wardrobe = empty_wardrobe()
    data[username] = wardrobe

categories = list(wardrobe.keys()) # grabing category names and putting them into a list

print("Add your clothes. Type 'done' when finished.\n")

while True:
    print("Categories:", ", ".join(categories))                 # allows user to choose a category
    cat = input("Category (or 'done'): ").strip().lower()     # takes their input and strips it and makes it all lowercase

    if cat == "done":    #if they print done then break out of the loop
        break
    if cat not in wardrobe:              #if they input something that is not a category then prompt them to try again
        print("Invalid category, try again.")
        continue

    item = input(f"Item name for {cat}: ").strip() #allows them to input an item and strips it
    if item:
        wardrobe[cat].append(item) #adds item to list and prints it back
        print(f"Added '{item}' to {cat}.\n")

    if item:
        if item not in wardrobe[cat]:
            wardrobe[cat].append(item)
            print(f"Added '{item}' to {cat}.\n")
        else:
            print(f"'{item}' is already in {cat}.\n")

show_wardrobe(wardrobe)

OCCASIONS = [  #lists possible occasions
    "casual",
    "work / class",
    "going out",
    "formal / event",
    "outdoor / active",
    "date"
]

print("What's the occasion?") # asks user what the occasions is
for i, occ in enumerate(OCCASIONS, 1): #loops through occasions and assigns them each a number starting at 1 tomorrow
    print(f"  {i}. {occ}")

while True: #start loop that asks user for the occasions
    choice = input("\nEnter a number or type your own: ").strip()

    if choice.isdigit() and 1 <= int(choice) <= len(OCCASIONS): #makes sure input is a number converts to integer and makes sure it is within the length of occasions
        occasion = OCCASIONS[int(choice) - 1] #subtracts 1 from choice beacuse indexing starts at 0 but occ list starts at 1
        break
    elif choice:
        occasion = choice.lower() #makes choice lowercase
        break
    else:
        print("Please enter something.")

print(f"\nOccasion: {occasion}")

data[username] = wardrobe
save_data(data)
print("Your wardrobe has been saved.")
